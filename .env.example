# Copy to .env and fill in only the providers you use.
# auto picks Groq, then Gemini, then OpenAI, then the local GGUF file.

LLM_PROVIDER=auto
LLM_MODEL=
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Local fallback. scripts/download_model.py fetches this file.
LLM_MODEL_PATH=data/models/qwen2.5-1.5b-instruct-q4_k_m.gguf
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

DATA_DIR=data
CORPUS_TARGET=50000
PORT=8741
